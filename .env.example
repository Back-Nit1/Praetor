# Copy to .env (gitignored). Never commit real keys.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Model tiers — T1 verifies ids via scripts/check_models.py
MODEL_ULTRA=
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_NANO=
TAVILY_API_KEY=
# Hard spend cap for LLM calls (USD)
NEMESIS_MAX_USD=15
# 1 = cache LLM + Tavily responses on disk, 0 = disable
NEMESIS_CACHE=1
# 1 = hosted demo: synthetic personas only, live scans refused
NEMESIS_DEMO_MODE=1
